{
  "name": "nur-landing",
  "version": "0.1.0",
  "private": true,
  "description": "NUR LEARN — an evidence-led learning platform for Integrated TCM and Western Medicine clinical students.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nur562-svg/Nur-landing.git"
  },
  "homepage": "https://github.com/Nur562-svg/Nur-landing",
  "bugs": {
    "url": "https://github.com/Nur562-svg/Nur-landing/issues"
  },
  "keywords": [
    "medical-education",
    "tcm",
    "integrated-medicine",
    "learning-platform",
    "nextjs",
    "react",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "preview": "opennextjs-cloudflare build && node scripts/clean-opennext.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/clean-opennext.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "quick-check": "node scripts/quick-check.mjs",
    "quick-check:staged": "node scripts/quick-check.mjs --staged",
    "test": "tsx --test tests/**/*.test.ts",
    "prepare": "node scripts/install-hook.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/react": "^4.0.40",
    "@base-ui/react": "^1.3.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/nodemailer": "^8.0.1",
    "ai": "^7.0.37",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.6.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "wrangler": "^4.122.0"
  }
}
