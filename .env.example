# === 数据库 ===
# Prisma CLI（migrate/diff）使用此 URL；运行时连接由 adapter 决定。
# 本地开发：file:./prisma/dev.db（SQLite）
# 生产：postgresql://user:strongpass@host:5432/dbname?schema=public
# 生产必须通过 .env.local 提供完整值（切勿提交真实密钥）
DATABASE_URL="file:./prisma/dev.db"

# === 认证 ===
# JWT 签名密钥（**生产必须重新生成**）
#   生成命令：openssl rand -base64 32
# 代码中 AUTH_SECRET 缺失时会立即 throw（见 src/lib/auth/session.ts）
# 绝不回退到任何默认弱密钥
AUTH_SECRET=""

# === 站点配置（可选，仅 NEXT_PUBLIC_ 前缀暴露给客户端）===
# 部署前在 .env.local 设置真实备案域名与信息
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# NEXT_PUBLIC_SITE_DOMAIN="your-domain.com"
# NEXT_PUBLIC_ICP_RECORD_NUMBER=""
# NEXT_PUBLIC_PUBLIC_SECURITY_RECORD_NUMBER=""
# NEXT_PUBLIC_CONTACT_EMAIL="contact@your-domain.com"

# === 邮件（SMTP，收费前可留空，console 模式输出到终端）===
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="NUR LEARN <noreply@your-domain.com>"

# === 支付（默认 mock 演示模式，商户号到位后切换）===
# PAYMENT_PROVIDER=mock  # mock | wechat | alipay
# WECHAT_PAY_MCHID=""
# WECHAT_PAY_APP_ID=""
# WECHAT_PAY_SERIAL_NO=""
# WECHAT_PAY_PRIVATE_KEY_PATH=""
# WECHAT_PAY_APIV3_KEY=""
# ALIPAY_APP_ID=""
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""

# === 定时补偿（生产 cron 调用 /api/pay/cron/reconcile 时验证）===
# CRON_SECRET=""

# === AI 模型（可选，仅服务端使用）===
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NUR_COURSE_BUILDER_PROVIDER=dashscope
NUR_COURSE_BUILDER_MODEL=qwen3.7-plus

XAI_API_KEY=
NUR_AGENT_PROVIDER=xai
NUR_AGENT_MODEL=grok-4.3
