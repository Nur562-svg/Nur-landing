# === 数据库 ===
# Prisma CLI（migrate/diff）使用此 URL；运行时连接由 adapter 决定。
# 本地开发：file:./prisma/dev.db（SQLite）
# 生产：postgresql://user:strongpass@host:5432/dbname?schema=public
# 生产必须通过 .env.local 提供完整值（切勿提交真实密钥）
DATABASE_URL="file:./prisma/dev.db"

# === 认证 ===
# JWT 签名密钥（**生产必须重新生成**）
#   生成命令：openssl rand -base64 32
# 代码中 AUTH_SECRET 缺失时会立即 throw（见 src/lib/auth/session.ts）
# 绝不回退到任何默认弱密钥
AUTH_SECRET=""

# === 站点配置（可选，仅 NEXT_PUBLIC_ 前缀暴露给客户端）===
# 部署前在 .env.local 设置真实备案域名与信息
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# NEXT_PUBLIC_SITE_DOMAIN="your-domain.com"
# NEXT_PUBLIC_ICP_RECORD_NUMBER=""
# NEXT_PUBLIC_PUBLIC_SECURITY_RECORD_NUMBER=""
# NEXT_PUBLIC_CONTACT_EMAIL="contact@your-domain.com"

# === 对公课程发布面（默认 = 全部已注册课程）===
# 收窄示例：NEXT_PUBLIC_PUBLISHED_COURSE_SLUGS="tcm-diagnostics,physiology,physiology-qb"
# NEXT_PUBLIC_PUBLISHED_COURSE_SLUGS=*

# === 邮件（SMTP，收费前可留空，console 模式输出到终端）===
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Ariadne <noreply@your-domain.com>"

# === 支付（默认 mock 演示模式，商户号到位后切换）===
# PAYMENT_PROVIDER=mock  # mock | wechat | alipay
# WECHAT_PAY_MCHID=""
# WECHAT_PAY_APP_ID=""
# WECHAT_PAY_SERIAL_NO=""
# WECHAT_PAY_PRIVATE_KEY_PATH=""
# WECHAT_PAY_APIV3_KEY=""
# ALIPAY_APP_ID=""
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""  # 支付宝公钥（验签用，非应用公钥）
# ALIPAY_GATEWAY_URL=""  # 缺省沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do；生产 https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=""  # 缺省由 NEXT_PUBLIC_SITE_URL 拼装 {base}/api/pay/notify/alipay

# === 定时补偿（生产 cron 调用 /api/pay/cron/reconcile 时验证）===
# CRON_SECRET=""

# === Clew 教材存储（服务器私有，仅本人可见）===
# 生产默认 /data/clew（docker 持久卷）；本地开发默认 <repo>/.clew-storage
# CLEW_STORAGE_ROOT="/data/clew"
# CLEW_STORAGE_DRIVER=local  # local（当前唯一实现）；OSS 适配器后置

# === AI 模型（可选，仅服务端使用）===
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NUR_COURSE_BUILDER_PROVIDER=dashscope
NUR_COURSE_BUILDER_MODEL=qwen3.7-plus

# === Clew 多模型接入（ZCODE-M4）：任务级 env > 全局 env > 缺省 ===
# 任务 ∈ TOC / EXTRACT / LESSON / CHAT / NOTE；provider 取值 dashscope | openai-compatible；
# deepseek / kimi / zhipu 未实现，显式配置会明确报错（不静默回落）。
# 全局（对所有 Clew 任务生效）：
# CLEW_MODEL_PROVIDER=dashscope
# CLEW_MODEL=qwen3.7-plus
# CLEW_MODEL_BASE_URL=            # openai-compatible 必填；仅本地回环地址允许 http
# CLEW_MODEL_API_KEY=             # openai-compatible 密钥（本地 Ollama 可填占位值 ollama）
# 已核实 OpenAI 兼容端点（写 CLEW_{TASK}_BASE_URL 或 CLEW_MODEL_BASE_URL）：
#   DeepSeek  https://api.deepseek.com
#   Kimi      https://api.moonshot.cn/v1
#   智谱 GLM  https://open.bigmodel.cn/api/paas/v4 （必须带全路径，只写域名会 404）
#   Ollama    http://localhost:11434/v1
# 任务级覆盖示例（讲义任务走 DeepSeek）：
# CLEW_LESSON_PROVIDER=openai-compatible
# CLEW_LESSON_MODEL=deepseek-chat
# CLEW_LESSON_BASE_URL=https://api.deepseek.com
# CLEW_LESSON_API_KEY=

XAI_API_KEY=
NUR_AGENT_PROVIDER=xai
NUR_AGENT_MODEL=grok-4.3
