// NUR LEARN 数据层（Prisma）
// 开发环境使用 SQLite 文件库（零依赖）；生产环境切换 Postgres 只需修改 provider 与连接串。
// 注意：不使用原生 enum（SQLite 不支持），枚举语义由 TypeScript 类型约束保证可移植性。
//
// 重要：不要为 client 指定自定义 output 目录——OpenNext Cloudflare 会 patch
// node_modules/@prisma/client 使其在 workerd 运行时工作（含 wasm 预编译加载）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  displayName         String
  // membershipTier: "free" | "basic" | "pro" | "max"（TS 类型约束保证可移植性；旧 lite 数据迁移为 basic）
  membershipTier      String    @default("free")
  // 会员到期时间（null = free/basic）；到期后自动回退 free
  membershipExpiresAt DateTime?
  // 邮箱验证时间（null = 未验证）；收费前须完成验证
  emailVerifiedAt     DateTime?
  // M3: usage counters for quota (courseBuilds, agentCalls, etc.)
  usage               Json? // { courseBuilds?: number, agentCalls?: number }
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // M2: 学习状态云同步（FSRS、尝试记录、题库、模考）。复用现有 browser contracts 的结构化字段。
  learnerAttempts               LearnerAttempt[]
  learnerFsrsStates             LearnerFsrsState[]
  qbAttempts                    QbAttempt[]
  qbFavorites                   QbFavorite[]
  mockExamSessions              MockExamSession[]
  // 私人材料准入记录的云同步需单独明确同意（learner-private 边界保持）
  materialAdmissionSyncConsents MaterialAdmissionSyncConsent[]
  // M4: 会员订单（支付体系）
  orders                        Order[]
  // M4: 密码重置令牌
  passwordResetTokens           PasswordResetToken[]
  courseEntitlements            CourseEntitlement[]
  // Hi doc: 用户私有教材（服务器存储，仅本人可见，不进官方课程目录）
  hiDocTextbooks                HiDocTextbook[]
}

/// M4: 会员订单（支付抽象层持久化）。provider 切换不影响已存订单。
model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 套餐标识：basic-month | basic-quarter | basic-year | pro-* | max-*（旧 lite-* 数据迁移为 basic-*）
  planId          String
  // "lite" | "pro"
  tier            String
  // "month" | "quarter" | "year"
  period          String
  // 订单金额（分），避免浮点误差
  amountCents     Int
  // 支付渠道："mock" | "wechat" | "alipay"
  channel         String
  // "pending" | "paid" | "closed" | "refunded"
  status          String    @default("pending")
  // 渠道方交易号（微信/支付宝回调返回）
  providerTradeNo String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

/// Hi doc M0: 官方课程名额。试点课白名单不占名额、不写行。
model CourseEntitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  grantedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId, grantedAt])
}

/// Hi doc M1: 用户私有教材（服务器存储、按 userId 隔离；不进官方课程目录、不进 /courses）。
model HiDocTextbook {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  fileName String
  // 存储抽象键（hidoc/{userId}/{textbookId}/{fileName}）；本地磁盘卷与 OSS 适配后语义一致
  storageKey   String   @unique
  sizeBytes    Int
  pageCount    Int
  // M1 上传即检测：无文字层（扫描版）直接拒绝，不落库
  hasTextLayer Boolean  @default(true)
  // "uploaded" | "toc_ready" | "extracting" | "ready" | "failed"
  status       String   @default("uploaded")
  // M2 目录识别结果（章节数组）
  toc          Json?
  // 激活月（YYYY-MM，Asia/Shanghai）；跨月进入冻结态，重新激活占用当月名额
  activeMonth  String
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, activeMonth, deletedAt])
  @@index([userId, createdAt])

  chapters HiDocChapter[]
}

/// Hi doc M3: 章节知识点（模型萃取草稿，含页码溯源；私有挂教材章节）。
model HiDocKnowledgePoint {
  id         String      @id @default(cuid())
  chapterId  String
  chapter    HiDocChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  description String
  keyTerms    Json // string[]
  prerequisites Json // string[]（章节内先修知识点标题）
  // 该知识点在 PDF 中的页序（1 起，与章节页码同源）
  sourcePage  Int
  createdAt   DateTime @default(now())

  @@index([chapterId, order])
}

/// Hi doc M2: 教材章节（目录识别结果 / 手动修正结果；页码为 PDF 页序，1 起）。
model HiDocChapter {
  id         String       @id @default(cuid())
  textbookId String
  textbook   HiDocTextbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  order     Int
  title     String
  pageStart Int
  pageEnd   Int
  // 来源："outline"（PDF 书签）| "toc-page"（印刷目录页）| "model"（模型解析）| "manual"（人工修正）
  source    String   @default("manual")
  // M3 萃取状态："pending" | "extracting" | "extracted" | "failed"；M2 只写 pending
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgePoints HiDocKnowledgePoint[]

  @@index([textbookId, order])
}

/// M4: 密码重置令牌（一次性，15 分钟过期）。
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// M5: 极简自研埋点（PV / 注册转化 / 关键漏斗计数），不引第三方 SDK。
model EventLog {
  id        String   @id @default(cuid())
  event     String // "page_view" | "signup" | "login" | "order_create" | "order_paid" | ...
  userId    String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId])
}

model LearnerAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId         String
  courseVersionId  String?
  offeringId       String?
  knowledgePointId String
  surface          String // "subjective-writing" | "case-reasoning"
  taskId           String
  segmentId        String?

  confirmedText    String
  criterionResults Json // 复用 LearnerAttemptCriterionResult[]
  answerConfidence String
  scoringStandard  Json? // {id, version, authority}

  createdAt DateTime @default(now())

  @@index([userId, courseId, knowledgePointId])
  @@index([userId, createdAt])
}

model LearnerFsrsState {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  criterionId  String // 对应 memory criterion（知识点+任务维度）
  state        String // "new" | "learning" | "review" | "relearning"
  difficulty   Float
  stability    Float
  reps         Int       @default(0)
  lapses       Int       @default(0)
  lastReviewAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([userId, criterionId])
  @@index([userId])
}

model QbAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  attemptedAt   DateTime @default(now())

  @@index([userId, questionId])
}

model QbFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model MockExamSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId   String    @unique
  courseId    String
  startedAt   DateTime
  completedAt DateTime?
  answers     Json // 复用 MockExamPaperItem answers
  score       Json? // objective + pending

  createdAt DateTime @default(now())

  @@index([userId, courseId])
}

model MaterialAdmissionSyncConsent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  admissionRecordId String // 对应 browser 端 versioned record 的 id
  consentGiven      Boolean   @default(false)
  consentedAt       DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, admissionRecordId])
}
